# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
.next/
out/
npm-debug.log*
# Кэш инкрементальной сборки TypeScript: машинный артефакт, который
# меняется при каждом запуске tsc/next build и засоряет диффы.
*.tsbuildinfo

# Данные: сырьё и производные пересобираются пайплайном
data/raw/
data/processed/*
data/models/
web/.next/

# Исключение: разбивка матчей НХЛ по периодам.
#
# Это не промежуточный мусор, а снимок дорогого источника: каждая строка
# стоит одного запроса к gamecenter, и полная пересборка — это десять
# тысяч запросов к API. Файл маленький (35 КБ на десять тысяч матчей),
# поэтому он лежит в репозитории: CI берёт его как seed и докачивает
# только новые матчи, а не начинает с нуля. На сервере он всё равно
# пересобирается на каждом цикле из собственного кэша.
!data/processed/nhl_periods.parquet

# Исключение: датасет матчей NBA.
#
# Нужен как запасной источник данных для CI. Официальный API NBA
# (stats.nba.com) с раннеров GitHub недоступен — все запросы истекли
# по таймауту, — и свежий датасет CI берёт с витрины (её собирает
# сервер). Этот файл — запасной вариант на случай, если витрина
# недоступна. Размер 75 КБ на четыре тысячи матчей, так что держать
# его в репозитории недорого. На сервере он всё равно пересобирается
# на каждом цикле из собственного кэша.
!data/processed/nba_matches.parquet

# ВНИМАНИЕ: web/public/data НЕ игнорируется. Это единственный канал доставки
# данных на сайт — витрина читает файлы отсюда, а пайплайн кладёт их коммитом.
# Если вернуть эту строку в ignore, сайт на деплое останется пустым,
# и это будет выглядеть как «данные не приходят», а не как ошибка сборки.

# Журналы прогнозов — тоже коммитятся: без них в CI обнулялась бы история
# и невозможно было бы ответить, помогает ли обновление ближе к матчу.
!data/forecast_log_football.jsonl
!data/forecast_log_basketball.jsonl

# Архивы прежних данных. В data/raw_old лежат выгрузки сырья и разборы
# периодов НХЛ, которые сервер копил у себя: они большие, к нужному
# состоянию не относятся и в каждом прогоне перезаписываются. Их
# присутствие в рабочем каталоге ломало merge — git отказывался
# затирать неотслеживаемый файл, которого в HEAD нет.
#
# Исключения — два файла, которые ценны сами по себе: архив старого
# леджера НХЛ (локальная и серверная копии). Они не перезаписываются
# пайплайном и хранят историю прогнозов по старой модели.
data/raw_old/*
!data/raw_old/forecast_log_nhl_old_basketball_model.jsonl
!data/raw_old/forecast_log_nhl_old_basketball_model_server.jsonl

# Отчёты о загрузке фикстур — машинный мусор, перезаписывается при
# каждом прогоне. Раньше такие файлы копились на сервере как
# неотслеживаемые и ломали merge тем же способом.
#
# Шаблон шире, чем «*_fixtures_ingest.json»: встречается ещё
# nba_future_fixtures_v3_ingest.json, где суффикс не в конце.
# Отслеживаемые nba_ingest.json / nhl_ingest.json / wnba_ingest.json
# под шаблон не попадают — в них нет слова «fixtures».
data/reports/*fixtures*_ingest.json

# Секреты
.env
.env.local

# OS
.DS_Store
Thumbs.db
